<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PasswordGenerator.App.ViewModels"
        x:Class="PasswordGenerator.App.Views.ChangePasswordWindow"
        x:DataType="vm:ChangePasswordViewModel"
        Title="Password Generator · Change a password"
        Icon="/Assets/app.ico"
        Width="940"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Pg.WindowBg}"
        Foreground="{DynamicResource Pg.Text}"
        FontSize="14">
  <!-- Design CP1, option B: passwords on the left, typing order and the button on the right -->
  <Grid ColumnDefinitions="440,*">

    <Border Background="{DynamicResource Pg.PaneBg}" BorderBrush="{DynamicResource Pg.Divider}" BorderThickness="0,0,1,0" Padding="24,20">
      <StackPanel Spacing="16">

        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
            <TextBlock Classes="h" Text="Current password" />
            <TextBlock Classes="sub" Text="the one you use now" />
          </StackPanel>
          <Grid ColumnDefinitions="*,8,60,8,64" Height="40">
            <TextBox x:Name="CurrentBox" Text="{Binding Current}" PasswordChar="•" RevealPassword="{Binding ShowCurrent}"
                     FontFamily="{StaticResource Pg.Mono}" FontSize="16" VerticalContentAlignment="Center" MinHeight="40"
                     PlaceholderText="Paste it here" AutomationProperties.Name="Current password" />
            <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Command="{Binding ToggleCurrentCommand}">
              <TextBlock Text="{Binding ShowCurrentLabel}" />
            </Button>
            <Button Grid.Column="4" Classes="secondary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Command="{Binding PasteCommand}">
              <TextBlock Text="Paste" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="26">
            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Classes="icon" Data="{StaticResource Icon.Lock}" Stroke="{DynamicResource Pg.SubText}" />
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Classes="sub" TextWrapping="Wrap" Margin="8,0" Text="{Binding StoreNote}" />
            <Button Grid.Column="2" Classes="link" Command="{Binding ForgetCommand}">
              <TextBlock Text="Forget it" />
            </Button>
          </Grid>
        </StackPanel>

        <Border Classes="divider" />

        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
            <TextBlock Classes="h" Text="New password" />
            <TextBlock Classes="sub" Text="{Binding NewHint}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,8,60,8,64" Height="40">
            <Border Background="{DynamicResource Pg.WindowBg}" BorderBrush="{DynamicResource Pg.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="12,0" ClipToBounds="True">
              <TextBlock Classes="mono" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding NewDisplay}" />
            </Border>
            <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Command="{Binding ToggleNewCommand}">
              <TextBlock Text="{Binding ShowNewLabel}" />
            </Button>
            <Button Grid.Column="4" Classes="secondary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Command="{Binding NewCommand}" AutomationProperties.Name="Make another new password">
              <TextBlock Text="New" />
            </Button>
          </Grid>
          <TextBlock Classes="sub" TextWrapping="Wrap" Text="Made with the elements, minimums and length set in the main window." />
        </StackPanel>

      </StackPanel>
    </Border>

    <DockPanel Grid.Column="1" Margin="28,20,28,0">
      <TextBlock DockPanel.Dock="Bottom" Classes="sub" Height="32" Text="Passwords are never sent anywhere." />

      <StackPanel Spacing="16">

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="24">
            <TextBlock Classes="h" Text="Typing order" />
            <TextBlock Grid.Column="1" Classes="sub" Text="typed from left to right" Margin="8,0,0,0" />
            <Button Grid.Column="2" Classes="link" Command="{Binding ResetCommand}">
              <TextBlock Text="Reset" />
            </Button>
          </Grid>
          <Border Background="{DynamicResource Pg.CardBg}" BorderBrush="{DynamicResource Pg.CardBorder}" BorderThickness="1" CornerRadius="8" Padding="7" MinHeight="100">
            <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepVm">
                  <Border Classes="step" Classes.cur="{Binding IsCurrent}" Classes.new="{Binding IsNew}">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="mini" Command="{Binding EarlierCommand}" AutomationProperties.Name="{Binding EarlierLabel}">
                        <TextBlock Text="‹" />
                      </Button>
                      <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                      <Button Classes="mini" Command="{Binding LaterCommand}" AutomationProperties.Name="{Binding LaterLabel}">
                        <TextBlock Text="›" />
                      </Button>
                      <Button Classes="mini" Width="24" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveLabel}">
                        <TextBlock Text="×" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="6" Height="30">
            <TextBlock Classes="sub" Text="Add" />
            <ItemsControl ItemsSource="{Binding Adders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AdderVm">
                  <Button Classes="secondary add" Command="{Binding Command}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="h" Height="20" Text="Type it into the window used last" />
          <Border Background="{DynamicResource Pg.CardBg}" BorderBrush="{DynamicResource Pg.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,0" Height="44">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Classes="icon" Data="{StaticResource Icon.Window}" Stroke="{DynamicResource Pg.SubText}" />
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Classes="sub" Text="Goes to" Margin="10,0" />
              <TextBlock x:Name="TargetText" Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding TargetTitle}" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="4">
              <TextBlock Classes="sub" Text="Delay between characters" />
              <Grid ColumnDefinitions="32,6,*,6,32" Height="32">
                <Button Classes="stepper" Width="32" Height="32" Command="{Binding CharDelayDownCommand}" AutomationProperties.Name="Shorter delay between characters">
                  <TextBlock Text="−" />
                </Button>
                <Border Grid.Column="2" Background="{DynamicResource Pg.CardBg}" BorderBrush="{DynamicResource Pg.CardBorder}" BorderThickness="1" CornerRadius="4">
                  <TextBlock Classes="num" Text="{Binding CharDelayText}" />
                </Border>
                <Button Grid.Column="4" Classes="stepper" Width="32" Height="32" Command="{Binding CharDelayUpCommand}" AutomationProperties.Name="Longer delay between characters">
                  <TextBlock Text="+" />
                </Button>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="sub" Text="Delay between tabs" />
              <Grid ColumnDefinitions="32,6,*,6,32" Height="32">
                <Button Classes="stepper" Width="32" Height="32" Command="{Binding TabDelayDownCommand}" AutomationProperties.Name="Shorter delay between tabs">
                  <TextBlock Text="−" />
                </Button>
                <Border Grid.Column="2" Background="{DynamicResource Pg.CardBg}" BorderBrush="{DynamicResource Pg.CardBorder}" BorderThickness="1" CornerRadius="4">
                  <TextBlock Classes="num" Text="{Binding TabDelayText}" />
                </Border>
                <Button Grid.Column="4" Classes="stepper" Width="32" Height="32" Command="{Binding TabDelayUpCommand}" AutomationProperties.Name="Longer delay between tabs">
                  <TextBlock Text="+" />
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <Panel MinHeight="108">
            <StackPanel Spacing="8" IsVisible="{Binding IsIdle}">
              <Button Classes="primary" Height="48" CornerRadius="6" FontSize="15" HorizontalAlignment="Stretch" Command="{Binding TypeCommand}">
                <TextBlock Text="Type it into that window" />
              </Button>
              <TextBlock Classes="sub" TextWrapping="Wrap" IsVisible="{Binding ShowHint}"
                         Text="First click into the first password box of the website or app, then come back and press the button. Typing starts at once, as in KeePass. Esc stops it." />
              <TextBlock Classes="sub" TextWrapping="Wrap" IsVisible="{Binding ShowLastTyped}" Text="{Binding LastTyped}" />
              <TextBlock Classes="problem" IsVisible="{Binding HasProblem}" Text="{Binding Problem}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding IsTyping}">
              <Border Height="48" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Pg.Accent}" Background="{DynamicResource Pg.CardBg}" Padding="14,0">
                <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Pg.ChipOnFg}" Text="Typing into the other window…" />
              </Border>
              <TextBlock Classes="sub" TextWrapping="Wrap" Text="Do not touch the keyboard or mouse until it finishes. Esc stops it." />
            </StackPanel>
          </Panel>
        </StackPanel>

      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
