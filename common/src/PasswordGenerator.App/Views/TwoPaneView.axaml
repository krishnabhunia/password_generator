<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PasswordGenerator.App.ViewModels"
             xmlns:v="using:PasswordGenerator.App.Views"
             x:Class="PasswordGenerator.App.Views.TwoPaneView"
             x:DataType="vm:MainViewModel">
  <!-- Designs "Two-pane Light" and "Two-pane Dark": choices on the left, the password on the right -->
  <Grid ColumnDefinitions="440,*">
    <Border Background="{DynamicResource Pg.PaneBg}" BorderBrush="{DynamicResource Pg.Divider}" BorderThickness="0,0,1,0" Padding="24,14,24,14">
      <StackPanel Spacing="10">

        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="Auto,*,Auto,40,Auto" Height="34">
            <TextBlock Classes="h" Text="Password length" />
            <TextBlock Grid.Column="1" Classes="sub" Text="4 to 64" Margin="8,0,0,0" />
            <Button Grid.Column="2" Classes="stepper" Width="32" Height="32" Command="{Binding LengthDecCommand}" AutomationProperties.Name="Shorter password">
              <TextBlock Text="−" />
            </Button>
            <TextBlock Grid.Column="3" Classes="num" FontSize="18" Text="{Binding Length}" />
            <Button Grid.Column="4" Classes="stepper" Width="32" Height="32" Command="{Binding LengthIncCommand}" AutomationProperties.Name="Longer password">
              <TextBlock Text="+" />
            </Button>
          </Grid>
          <Slider Margin="0,-8,0,-12" Minimum="4" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LengthValue}" AutomationProperties.Name="Password length" />
        </StackPanel>

        <Border Classes="divider" />

        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto" Height="20">
            <TextBlock Classes="h" Text="Elements to use" />
            <TextBlock Grid.Column="1" Classes="sub" Text="Minimum of each" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Elements}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ElementVm">
                <v:ElementRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider" />

        <StackPanel Spacing="6">
          <v:ElementRow DataContext="{Binding Special}" />
          <ItemsControl ItemsSource="{Binding Symbols}" Margin="-3">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SymbolVm">
                <Button Classes="chip" Classes.on="{Binding IsActive}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Label}">
                  <TextBlock Text="{Binding Char}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto,Auto" Height="26">
            <TextBlock Classes="sub" Text="{Binding SymbolCountText}" />
            <Button Grid.Column="1" Classes="link" Command="{Binding SelectAllSymbolsCommand}">
              <TextBlock Text="Select all" />
            </Button>
            <Button Grid.Column="2" Classes="link" Command="{Binding ClearSymbolsCommand}">
              <TextBlock Text="Clear" />
            </Button>
          </Grid>
        </StackPanel>

      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" Margin="32,26,32,18" Spacing="14">
      <TextBlock Classes="sub" FontSize="13" Text="Generated password" />

      <Border Classes="pwdbox" MinHeight="150" Padding="20,16">
        <Panel>
          <ItemsControl ItemsSource="{Binding Chars}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CharVm">
                <TextBlock Classes="pwd" Classes.digit="{Binding IsDigit}" Classes.symbol="{Binding IsSymbol}" FontSize="28" Text="{Binding Text}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="sub" FontSize="14" VerticalAlignment="Top" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                     Text="Switch on at least one element to generate a password." />
        </Panel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Pg.Letter}" />
          <TextBlock Classes="sub" Text="Letters" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Pg.Digit}" />
          <TextBlock Classes="sub" Text="Digits" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Pg.Symbol}" />
          <TextBlock Classes="sub" Text="Special characters" />
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto,Auto" Height="18">
        <ProgressBar Classes="meter" Classes.fair="{Binding IsFair}" Classes.strong="{Binding IsStrong}" Classes.vstrong="{Binding IsVeryStrong}" Value="{Binding MeterFraction}" />
        <TextBlock Grid.Column="1" Classes="strength" Classes.fair="{Binding IsFair}" Classes.strong="{Binding IsStrong}" Classes.vstrong="{Binding IsVeryStrong}" Text="{Binding StrengthLabel}" Margin="12,0,0,0" />
        <TextBlock Grid.Column="2" Classes="sub" Text="{Binding BitsText}" Margin="12,0,0,0" />
      </Grid>

      <TextBlock Classes="sub" FontSize="13" TextWrapping="Wrap" Text="{Binding Recipe}" />

      <Grid ColumnDefinitions="*,12,170" Height="48" Margin="0,6,0,0">
        <Button Classes="primary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="6" FontSize="15" Command="{Binding CopyCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Classes="icon" Data="{StaticResource Icon.Copy}" Stroke="{Binding $parent[Button].Foreground}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="{Binding CopyLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="6" FontSize="15" Command="{Binding RegenerateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Classes="icon" Data="{StaticResource Icon.Refresh}" Stroke="{Binding $parent[Button].Foreground}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Regenerate" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
