<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PasswordGenerator</AssemblyName>
    <RootNamespace>PasswordGenerator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Password Generator</Product>
    <Company>Krishna Bhunia</Company>
    <AssemblyTitle>Password Generator</AssemblyTitle>
    <!-- The pipeline passes -p:PwgVersion=x.y.z or x.y.z-betaNNN. A local build is 0.0.0. -->
    <PwgVersion Condition="'$(PwgVersion)' == ''">0.0.0</PwgVersion>
    <Version>$(PwgVersion)</Version>
    <InformationalVersion>$(PwgVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- One self-contained file when publishing for a platform (dotnet publish -r win-x64). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SourcePr" Value="$(PwgSourcePr)" />
    <AssemblyMetadata Include="SourceCommit" Value="$(PwgSourceCommit)" />
    <AssemblyMetadata Include="BuildTimeUtc" Value="$(PwgBuildTimeUtc)" />
    <AssemblyMetadata Include="ReleaseTag" Value="$(PwgReleaseTag)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown in the Info window: What's implemented and What's new. -->
    <EmbeddedResource Include="..\..\..\docs\FEATURES.md" LogicalName="FEATURES.md" Link="Docs\FEATURES.md" />
    <EmbeddedResource Include="..\..\..\docs\CHANGELOG.md" LogicalName="CHANGELOG.md" Link="Docs\CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- Windows data protection (DPAPI) for the stored current password. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordGenerator.Core\PasswordGenerator.Core.csproj" />
  </ItemGroup>
</Project>
